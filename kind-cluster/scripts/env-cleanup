#!/bin/bash
exec >> /proc/1/fd/1 2>&1

# Cleanup script to remove the K3d cluster

CLUSTER_NAME=${1:-cluster}

# Check if CLUSTER_NAME is set
if [ -z "$CLUSTER_NAME" ]; then
    echo "CLUSTER_NAME is not set"
    exit 1
fi

# Check if the K3d cluster is running
if k3d cluster list | grep -q "$CLUSTER_NAME"; then
    # Delete the K3d cluster
    k3d cluster delete "$CLUSTER_NAME"

    # Wait until the cluster is fully deleted (bounded: k3d delete is
    # synchronous, so this should exit immediately)
    DELETE_WAIT=0
    while k3d cluster list | grep -q "$CLUSTER_NAME"; do
        DELETE_WAIT=$((DELETE_WAIT+1))
        [ "$DELETE_WAIT" -ge 60 ] && { echo "Timed out waiting for '$CLUSTER_NAME' to be deleted"; break; }
        sleep 1
    done

    echo "K3d cluster '$CLUSTER_NAME' has been deleted."
else
    echo "K3d cluster '$CLUSTER_NAME' is not running."
fi

# Remove resources the deleted cluster may have left behind. This runs inside
# the k8s-api-server container's own Docker daemon (docker:dind), one daemon per
# session, so the filters below can never touch another session or the host.
echo "Cleaning up Docker resources for cluster '$CLUSTER_NAME'..."
docker volume ls -q --filter "label=k3d.cluster=$CLUSTER_NAME" | xargs -r docker volume rm -f > /dev/null 2>&1 || true
docker network ls -q --filter "label=k3d.cluster=$CLUSTER_NAME" | xargs -r docker network rm > /dev/null 2>&1 || true

# Older k3d releases do not label every leftover volume; catch name matches too.
for volume in $(docker volume ls -q | grep -F "k3d-$CLUSTER_NAME"); do
    docker volume rm -f "$volume" > /dev/null 2>&1 || true
done

echo "Docker resources for cluster '$CLUSTER_NAME' cleaned up."

# Delete K3d config file if present
if [ -f "/tmp/k3d-config.yaml" ]; then
    rm -f /tmp/k3d-config.yaml
    echo "K3d config file deleted."
fi

# Delete kubeconfig file if present in /home/candidate/.kube/kubeconfig (adjust path if needed)
if [ -f "/home/candidate/.kube/kubeconfig" ]; then
    rm -f /home/candidate/.kube/kubeconfig
    echo "Kubeconfig file deleted."
fi

echo "Cleanup completed."
exit 0
