# CK-X environment overrides
# Copy to .env and adjust. All values below are optional; defaults shown.

# Multisession rollout flag (false keeps the current single-environment flow)
MULTISESSION_ENABLED=false

# Maximum number of concurrent lab sessions (2-5 supported on one host)
MAX_SESSIONS=3

# HMAC secret for signed session cookies. REQUIRED when MULTISESSION_ENABLED=true.
# Production refuses to start if missing or shorter than 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for service-to-service calls (jumphost asset download).
# REQUIRED when MULTISESSION_ENABLED=true. Production refuses to start if
# missing or shorter than 16 characters. Generate with: openssl rand -hex 32
INTERNAL_TOKEN=

# URL the per-session jumphost uses to fetch exam assets, and the address the
# webapp uses to resolve the caller's session
FACILITATOR_URL=http://facilitator:3000

# Tag used by per-session data-plane stacks
SESSION_IMAGE_TAG=dev

# Shared control network for the webapp and session desktops/terminals
SESSION_CONTROL_NETWORK=ckx-sessions

# Environment provider used for per-session data planes
ENV_PROVIDER=docker-compose

# Redis TTL for exam data (seconds). Must exceed longest lab + review time.
EXAM_DATA_TTL_SECONDS=28800

# Session lifetime (seconds). Also used as the session cookie Max-Age.
SESSION_TTL_SECONDS=28800

# Reap a session with no API/heartbeat activity for this long (seconds).
# Set to 0 to disable idle expiry (the hard TTL still applies).
SESSION_IDLE_SECONDS=1800

# How often the facilitator sweeps idle/hard-expired sessions and orphan
# environments (seconds).
SESSION_SWEEP_INTERVAL_SECONDS=60

# Admin bearer token for GET /api/v1/sessions. Falls back to INTERNAL_TOKEN
# when empty. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
